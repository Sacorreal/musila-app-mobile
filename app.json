{
  "expo": {
    "name": "Musila",
    "slug": "musila",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "musilaappmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.sacorrea.musila",
      "buildNumber": "1",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "LSApplicationQueriesSchemes": ["instagram-stories", "instagram"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0274DF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "package": "com.sacorrea.musila",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "@react-native-vector-icons/ant-design",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080B12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "ios": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 200,
            "backgroundColor": "#080B12"
          },
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 200,
            "backgroundColor": "#080B12"
          }
        }
      ],
      "expo-secure-store",
      "expo-audio",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Musila necesita acceso a tu galería para seleccionar la portada del track.",
          "cameraPermission": "Musila necesita acceso a tu cámara para tomar una foto de portada."
        }
      ],
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#208AEF",
          "sounds": []
        }
      ],
      "expo-status-bar",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "72391c15-4f65-4877-8c19-8ae262affc49"
      }
    },
    "owner": "sacorrea",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/72391c15-4f65-4877-8c19-8ae262affc49"
    }
  }
}
